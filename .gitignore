# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
coverage
apps/*/coverage
*.local

# TypeScript incremental build state. Committing it makes `tsc -b` a no-op when the
# outputs are missing, so a build can silently produce nothing.
*.tsbuildinfo

# Environment variables - Local overrides
# Commitear: .env, .env.development, .env.production, .env.test
# NO commitear: .env.local, .env.*.local
.env.local
.env.*.local
.env.development.local
.env.production.local
.env.test.local

# Claude Code - local, per-developer overrides (project settings.json IS committed)
.claude/settings.local.json
.claude/worktrees/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# HTTP Client private environment variables
http-client.private.env.json

# HTTP requests with sensitive tokens (keep .example files)
apps/backend/http-requests/*.http
!apps/backend/http-requests/*.http.example
