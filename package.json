{
  "name": "friends-monorepo",
  "private": true,
  "version": "0.9.0",
  "$schema": "https://json.schemastore.org/package.json",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev:frontend": "pnpm --filter @friends/frontend dev",
    "dev:backend": "pnpm --filter @friends/backend dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @friends/frontend build",
    "build:backend": "pnpm --filter @friends/backend build",
    "preview": "pnpm --filter @friends/frontend preview",
    "build:types": "pnpm --filter @friends/shared-types build",
    "check:skills": "node scripts/check-skills-symlinks.mjs",
    "fix:skills": "node scripts/fix-skills-symlinks.mjs",
    "check:env": "node scripts/check-env-files.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "lint": "pnpm build:types && pnpm check:skills && pnpm check:env && pnpm check:catalog && pnpm format:check && pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix && pnpm format",
    "test": "pnpm build:types && pnpm -r test:run",
    "test:watch": "pnpm -r --parallel test:watch",
    "test:coverage": "pnpm -r test:coverage",
    "format": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "globals": "catalog:",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "@nestjs/swagger>js-yaml": "^5.4.1",
      "@nestjs/platform-express>multer": "^2.5.0"
    }
  }
}
